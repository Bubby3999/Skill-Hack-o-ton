# CareFit server configuration. Copy to .env: `cp .env.example .env`. No API keys needed.

# AI mode: `mock` (fixed replies, no Ollama; the default) or `live` (forwards to Ollama).
# Live mode never falls back to mock on its own.
AI_MODE=mock

# Local Ollama server. Only used when AI_MODE=live (and by /api/health).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Exact locally installed model name from `ollama list`, e.g. qwen2.5:7b. Empty is fine in mock mode.
OLLAMA_MODEL=
# How long to wait for the model before answering with a timeout error (ms).
OLLAMA_TIMEOUT_MS=60000

# Where `npm start` listens. Tailscale Funnel proxies to this port on localhost.
PORT=8787
HOST=127.0.0.1
